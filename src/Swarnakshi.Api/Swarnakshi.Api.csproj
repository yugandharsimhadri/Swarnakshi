<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Developer connection string and signing key live here, outside the repository. -->
    <UserSecretsId>swarnakshi-scops-api</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.0" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.0">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.0" />
    <PackageReference Include="Scalar.AspNetCore" Version="2.*" />
    <!-- The only logging dependency. A Windows service and an IIS worker both write console
         output to nowhere, so without a file sink an exception in production leaves no trace at
         all. Serilog.AspNetCore brings the rolling-file and console sinks in one reference. -->
    <PackageReference Include="Serilog.AspNetCore" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Swarnakshi.Infrastructure\Swarnakshi.Infrastructure.csproj" />
    <ProjectReference Include="..\Swarnakshi.Application\Swarnakshi.Application.csproj" />
    <ProjectReference Include="..\Swarnakshi.Domain\Swarnakshi.Domain.csproj" />
  </ItemGroup>

</Project>
