{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  // No connection string and no signing key here on purpose: both carry secrets, and this file is
  // in source control. Supply them per environment —
  //   production : appsettings.Production.json, written by deploy\scripts\New-ProductionSettings.ps1
  //   developer  : dotnet user-secrets (see docs/06-deployment.md)
  //   override   : the ConnectionStrings__Default / Jwt__Key environment variables
  // The app refuses to start outside Development if either is missing, rather than quietly
  // falling back to a local file or a well-known key.
  "ConnectionStrings": {
    "Default": ""
  },
  "Database": {
    "CommandTimeoutSeconds": 60
  },

  "Jwt": {
    "Issuer": "Swarnakshi",
    "Audience": "Swarnakshi",
    "Key": "",
    "AccessTokenMinutes": 60,
    "RefreshTokenDays": 7
  },
  "Cors": {
    "Origins": [ "http://localhost:6050" ]
  },
  "Seed": {
    "Demo": false
  }
}
